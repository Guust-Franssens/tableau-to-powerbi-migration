# Copy to `.env` (already git-ignored - see .gitignore) and fill in real values.
# `.env` is read by our own scripts (assess_estate.py, capture_tableau_oracle.py,
# harvest_estate_assets.py, stamp_tableau_provenance.py) via scripts/tableau_env.py.

# Tableau Cloud/Server site, e.g. https://10ax.online.tableau.com
TABLEAU_SERVER_URL=
# Site content URL segment (the part after /site/ in a Tableau URL); empty string for Default.
TABLEAU_SITE=

# Personal Access Token. The NAME is identical across both tiers of this toolkit.
TABLEAU_PAT_NAME=
# The SECRET is documented under this name by OUR scripts. The deterministic engine's own scripts
# (e.g. fetch_tds.py, estate_survey.py) read the same value under TABLEAU_PAT_VALUE instead.
# scripts/tableau_env.py accepts EITHER name here, and when OUR scripts spawn an engine script as a
# child process it sets the engine's name automatically - so for the normal pipeline, set only one.
#
# The bridge stops at the process boundary. If you run an engine script YOURSELF from a shell
# (e.g. estate_survey.py), it never sees our name: set TABLEAU_PAT_VALUE for that call. Its PAT
# *name* cannot come from a .env at all - the engine's credential_resolver only routes the SECRET
# through the .env layer - so pass --pat-name on the command line.
TABLEAU_PAT_SECRET=

# Optional overrides (defaults shown are what the scripts fall back to if unset).
# TABLEAU_REST_API_VERSION=3.21
