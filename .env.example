# Copy to `.env` (already git-ignored - see .gitignore) and fill in real values.
# Read by our own scripts (assess_estate.py, capture_tableau_oracle.py, harvest_estate_assets.py,
# stamp_tableau_provenance.py, tableau_lineage.py) via scripts/tableau_env.py, which layers this
# file over the process environment - so exporting these instead of writing a file also works.
#
# Our tier authenticates by PERSONAL ACCESS TOKEN ONLY. We cannot create one for you: Tableau's API
# answers HTTP 405 to create-PAT, so a Tableau user with access must issue it. A PAT also inherits
# its owner's permissions and cannot be scoped down, so a token from a restricted account sees less.

# Tableau Cloud/Server site, e.g. https://10ax.online.tableau.com
# (`TABLEAU_SERVER` is accepted as a deprecated alias and warns; rename it to this.)
TABLEAU_SERVER_URL=
# Site content URL segment (the part after /site/ in a Tableau URL); empty string for Default.
TABLEAU_SITE=

# Personal Access Token. The NAME is identical across both tiers of this toolkit.
TABLEAU_PAT_NAME=
# The SECRET is documented under this name by OUR scripts. The deterministic engine's own scripts
# (e.g. fetch_tds.py, estate_survey.py) read the same value under TABLEAU_PAT_VALUE instead.
# scripts/tableau_env.py accepts EITHER name here, and when OUR scripts spawn an engine script as a
# child process it sets the engine's name automatically - so for the normal pipeline, set only one.
#
# The bridge stops at the process boundary. If you run an engine script YOURSELF from a shell
# (e.g. estate_survey.py), it never sees our name: set TABLEAU_PAT_VALUE for that call. Its PAT
# *name* cannot come from a .env at all - the engine's credential_resolver only routes the SECRET
# through the .env layer - so pass --pat-name on the command line.
TABLEAU_PAT_SECRET=
# Same secret, under the name the ENGINE's own scripts read. Set this too if you will ever invoke an
# engine script directly - which the estate path documented in AGENTS.md does, at its very first
# step. ⚠️ Measured: with this unset, `estate_survey.py` does not fail - it prints
# "[auth] Tableau PAT secret: type it into THIS terminal now (input is hidden)" and then BLOCKS
# forever waiting for input no unattended or agent-driven run can supply. It reads as a network
# hang, so budget for a silent stall rather than an error message.
TABLEAU_PAT_VALUE=

# Optional overrides (defaults shown are what the scripts fall back to if unset).
# TABLEAU_REST_API_VERSION=3.21

# --- Fabric side (read by scripts/preflight.ps1 only) ---
# The Entra tenant you intend to DEPLOY into - the same value you pass to `deploy_estate.py
# --tenant`. Setting it turns on preflight's wrong-tenant check, which decodes the `tid` claim of a
# Fabric token and compares it, so `az` pointing at the wrong tenant is reported here rather than as
# a WorkspaceNotFound on a workspace that plainly exists. Leave it empty and preflight skips the
# check entirely (and never calls `az`), so a parse-only machine pays nothing.
#
# The GUID form is what gets compared; `az account show --query tenantId -o tsv` prints it. A
# default domain (contoso.onmicrosoft.com) also works - preflight resolves it via
# `az account list --all`. Quotes, surrounding whitespace and a trailing `# comment` are all fine.
# Declared HERE a mismatch is a warning; passed as `preflight.ps1 -Tenant <id>` on a run that is
# about to deploy, it blocks.
FABRIC_TENANT_ID=
