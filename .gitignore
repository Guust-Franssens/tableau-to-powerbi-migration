.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# The three migration trees share one shape (<tree>/<slug>/...), so these rules use `**/` to apply to
# all of them: examples/ (our worked examples), migrations/ (your workbook migrations) and
# datasources/ (your published-data-source migrations).

# Source Tableau workbooks / data sources may contain customer data - never commit
**/source/*.twb
**/source/*.twbx
**/source/*.tds
**/source/*.tdsx
**/source/*.hyper
examples/*/data/
migrations/*/data/
datasources/*/data/

# Reference screenshots of the SOURCE Tableau dashboards ARE committed in this repo - the
# sources here are public Tableau Public workbooks, and the before/after images are the whole
# point of the showcase. Keep them reasonably sized (downscale big infographic captures).
# If you adapt this toolkit to migrate real customer dashboards, that's your fork - apply your
# own data-handling policy there (e.g. re-add `**/reference/` here). We keep the
# capture bundle's local-only scratch out of git though:
**/reference/_thumbnails/
**/reference/manifest.json

# Fabric/PBI build output can be regenerated - keep repo lean (comment out if you want to version it)
# **/fabric/

# Migration _work scratch - full-folder backups, Desktop screenshots, downloaded
# boundary files. The re-runnable *.py transform scripts in _work ARE tracked.
**/_work/backup-*/
**/_work/*.png
**/_work/*.geojson

# Build-time scratch renders (skeleton/actual comparison screenshots)
**/_scratch/
**/_build/

# .NET build output from the TMDL validation helper C# projects - regenerated by
# `dotnet build`; only the Program.cs / *.csproj source belongs in git.
[Bb]in/
[Oo]bj/

# Tableau Public harvester downloads + parsed specs (bulk .twbx + specs, transient
# corpus for parser stress-testing / hard-workbook selection - never commit).
/_harvest/
candidates.json

# Power BI Desktop local cache/settings - machine-specific, regenerated automatically on open
**/.pbi/cache.abf
**/.pbi/localSettings.json
**/.pbi/editorSettings.json

.env
.env.local
*.log

# Copilot CLI feedback bundles - session scratch, can be huge (1.5GB+); never commit
copilot-feedback-*.tgz

# Compiled/binary Power BI files - always commit the unpacked PBIP/TMDL/PBIR instead
*.pbix

# OS cruft
.DS_Store
Thumbs.db

# uv lockfile - NOT committed on purpose. Running "uv lock" on a Microsoft-corp machine resolves against
# internal feeds (packagefeedproxy.microsoft.io / ms-feed-*.pkgs.visualstudio.com), which would leak
# internal infrastructure URLs and break "uv sync --frozen" for any external clone. The ">=" floors in
# pyproject.toml are the contract instead. To commit a lock, regenerate it against public PyPI first
# (UV_INDEX_URL=https://pypi.org/simple uv lock).
uv.lock
