.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# The three migration trees share one shape (<tree>/<slug>/...), so these rules use `**/` to apply to
# all of them: examples/ (our worked examples), migrations/workbooks/ (your workbook migrations) and
# migrations/datasources/ (your published-data-source migrations).

# Source Tableau workbooks / data sources may contain customer data - never commit
**/source/*.twb
**/source/*.twbx
**/source/*.tds
**/source/*.tdsx
**/source/*.hyper
# `**/` not `<tree>/*/data/`: the user trees are one level deeper (migrations/workbooks/<slug>/data/),
# so a fixed-depth rule would silently stop ignoring extracted customer data.
**/data/
# `tableau_lineage.py --download` pulls LIVE published data sources off Tableau Server into
# migrations/datasources/_downloads/. Never commit those.
**/_downloads/

# Reference screenshots of the SOURCE Tableau dashboards ARE committed for OUR examples/ - those
# sources are public Tableau Public workbooks, and the before/after images are the whole point of
# the showcase. Keep them reasonably sized (downscale big infographic captures).
#
# YOUR trees are the opposite default: a screenshot of a real customer dashboard is customer data,
# and this is where such work lands, so they are ignored. Un-ignore them only if you have cleared
# it (CONTRIBUTING.md: never stage customer-identifiable screenshots).
/migrations/workbooks/*/reference/
/migrations/datasources/*/reference/
# Local-only scratch from the capture bundle, in every tree:
**/reference/_thumbnails/
**/reference/manifest.json

# Fabric/PBI build output can be regenerated - keep repo lean (comment out if you want to version it)
# **/fabric/

# Migration _work scratch - full-folder backups, Desktop screenshots, downloaded
# boundary files. The re-runnable *.py transform scripts in _work ARE tracked.
**/_work/backup-*/
**/_work/*.png
**/_work/*.geojson

# Build-time scratch renders (skeleton/actual comparison screenshots)
**/_scratch/
**/_build/

# .NET build output from the TMDL validation helper C# projects - regenerated by
# `dotnet build`; only the Program.cs / *.csproj source belongs in git.
[Bb]in/
[Oo]bj/

# Tableau Public harvester downloads + parsed specs (bulk .twbx + specs, transient
# corpus for parser stress-testing / hard-workbook selection - never commit).
/_harvest/
candidates.json

# Power BI Desktop local cache/settings - machine-specific, regenerated automatically on open
**/.pbi/cache.abf
**/.pbi/localSettings.json
**/.pbi/editorSettings.json

.env
.env.local
*.log

# Ad-hoc test scaffolding. These exist to test the toolkit, not to ship with it: multi-model gate
# sweeps, throwaway Tableau fixtures, and test-account provisioning. They are hard-wired to one
# person's Databricks/Snowflake tenant (account ids, warehouse ids), so committing them puts private
# infrastructure identifiers in a public repo AND presents an end user with scripts that cannot work
# for them. Kept on disk, out of the repo.
scripts/gate_matrix.py
scripts/probe_lab.py
scripts/provision_snowflake_fixture.py
scripts/setup_snowflake_keypair.py
scripts/snowflake_fixture.sql
scripts/hooks/probe_subagent_start.ps1
tests/test_gate_matrix.py
_probe-lab/
_matrix/

# Credential material. `.env` alone was not enough: a real secret arrived as a loose
# `PAT-snowflake-secret.txt` in the repo root and a `git add -A` staged it (caught before commit,
# 2026-08-02). These patterns make that class of accident impossible rather than merely unlikely.
secrets/
*secret*.txt
*secret*.json
*.pat
*.pem
*.key
*.p8
*.p12
*.pfx
*credential*.txt
!scripts/credential_gate.py

# Copilot CLI feedback bundles - session scratch, can be huge (1.5GB+); never commit
copilot-feedback-*.tgz

# Compiled/binary Power BI files - always commit the unpacked PBIP/TMDL/PBIR instead
*.pbix

# OS cruft
.DS_Store
Thumbs.db

# uv lockfile - NOT committed on purpose. Running "uv lock" on a Microsoft-corp machine resolves against
# internal feeds (packagefeedproxy.microsoft.io / ms-feed-*.pkgs.visualstudio.com), which would leak
# internal infrastructure URLs and break "uv sync --frozen" for any external clone. The ">=" floors in
# pyproject.toml are the contract instead. To commit a lock, regenerate it against public PyPI first
# (UV_INDEX_URL=https://pypi.org/simple uv lock).
uv.lock

# Throwaway agent-behaviour test fixtures (see scripts/probe_lab.py)
_probe-lab/

# Live multi-source test fixture: embeds real endpoint hostnames, so it is generated
# on demand by scripts/make_live_source_fixture.py and never committed. tests/test_live_multisource.py
# skips when it is absent, so a clean clone and CI stay green without it.
tests/fixtures/live/


# Tableau oracle capture - data-bearing (Tableau's computed values + rendered PNGs)
_oracle/
