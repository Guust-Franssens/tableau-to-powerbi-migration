{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "powershell": "python scripts/hooks/credential_gate.py",
        "bash": "python scripts/hooks/credential_gate.py",
        "cwd": ".",
        "timeoutSec": 20
      }
    ],
    "permissionRequest": [
      {
        "type": "command",
        "powershell": "python scripts/hooks/credential_gate.py",
        "bash": "python scripts/hooks/credential_gate.py",
        "cwd": ".",
        "timeoutSec": 20
      }
    ]
  }
}
